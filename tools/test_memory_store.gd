extends SceneTree
const Memory=preload("res://scripts/voice/memory_store.gd")
func _initialize() -> void:
	var file:="res://services/luau-runtime/runtime/memory_test_%d.json"%Time.get_ticks_usec()
	var memory:=Memory.new();assert(memory.initialize(file,["a","b"]).is_empty())
	for index in 40: memory.put("a","heard","event_"+str(index),{"text":"普通事件"+str(index)},0.5)
	var important:=memory.put("a","heard","rescue",{"text":"同伴救了我","speaker":"b"},0.5)
	var private:=memory.put("b","reflection","private_b",{"text":"不应泄露的私下想法"},0.7)
	assert(memory.retained("a","heard").size()==41,"不能按24条截断")
	memory.consolidate("rest")
	var read:=memory.recall("a",{"kind":"heard","keywords":["救了我"],"limit":2})
	assert(read.ok and read.records.size()==1 and read.records[0].id==important)
	assert(memory.records.a[important].recall_count==1 and memory.records.a[important].half_life_days>3)
	assert(memory.recall("a",{"kind":"reflection","keywords":["私下"],"limit":2}).records.is_empty())
	assert(not memory.mark("a",{"id":private,"importance":1,"reason":"不能标记别人私下记忆"}).ok)
	assert(not memory.recall("a",{"kind":"heard","keywords":[],"limit":2,"person":"b"}).ok)
	assert(memory.mark("a",{"id":important,"importance":0.95,"reason":"重要的获救经历"}).ok)
	for index in 5: memory.contact("a","b")
	assert(memory.save().is_empty())
	var loaded:=Memory.new();assert(loaded.initialize(file,["a","b"]).is_empty())
	assert(loaded.records.a.has(important) and loaded.retained("a","heard").size()==41)
	loaded.advance(720*float(loaded.policy.day_seconds))
	assert(loaded.retained("a","heard").size()==1 and loaded.records.a.has(important),"普通事件遗忘，重要经历保留")
	assert(not loaded.contacts.a.has("b"),"长期不接触，熟悉度可消退；不能同时抹去重要事件")
	assert(loaded.save().is_empty())
	var reopened:=Memory.new();assert(reopened.initialize(file,["a","b"]).is_empty())
	assert(reopened.clock==loaded.clock and reopened.retained("a","heard").size()==1)
	print("MEMORY_STORE_PASSED persistence_over24_selective_recall_privacy_reinforcement_decay_relationships")
	quit()
